{
  "name": "nore-coffee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nore: a brand identity and storefront concept for a Bengaluru filter-coffee roaster.",
  "author": "Darshan P Pawar <darshanpawarworks@gmail.com> (https://darshanpawar7.github.io)",
  "license": "MIT",
  "homepage": "https://darshanpawar7.github.io/nore-coffee/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Darshanpawar7/nore-coffee.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --port 4104",
    "build": "astro build",
    "preview": "astro preview --port 4204",
    "typecheck": "astro check && tsc --project tsconfig.browser.json && tsc --project tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "wasm-fallback": "node scripts/wasm-fallback.ts"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/anek-kannada": "^5.3.0",
    "@fontsource-variable/anek-latin": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/preact": "^1.1.1",
    "astro": "^7.4.10",
    "nanostores": "^1.5.5",
    "preact": "^11.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "fontkit": "^2.0.4",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
