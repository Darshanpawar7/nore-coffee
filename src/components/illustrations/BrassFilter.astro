---
/** The two-chamber brass filter: lid, the upper chamber with its perforated floor, and the lower chamber. */
const holes = Array.from({ length: 9 }, (_, index) => 78 + index * 10.5);
---

<svg class="brass-filter" viewBox="0 0 240 300" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="brass" x1="0" x2="1">
      <stop offset="0" stop-color="#7a5618"></stop>
      <stop offset="0.3" stop-color="#e3c070"></stop>
      <stop offset="0.55" stop-color="#b5862b"></stop>
      <stop offset="1" stop-color="#6e4c14"></stop>
    </linearGradient>
  </defs>
  <ellipse cx="120" cy="282" rx="84" ry="8" fill="#1f1410" opacity="0.15"></ellipse>
  <path d="M50 150h140v112c0 10-6 16-16 16H66c-10 0-16-6-16-16z" fill="url(#brass)"></path>
  <path d="M50 150h140" stroke="#5c4012" stroke-width="3"></path>
  <path
    d="M62 198h116"
    stroke="#1f1410"
    stroke-opacity="0.35"
    stroke-width="2"
    stroke-dasharray="4 4"
  ></path>
  <text x="120" y="232" text-anchor="middle" class="brass-filter__label">
    decoction
  </text>
  <path d="M66 46h108v100H66z" fill="url(#brass)"></path>
  <path d="M60 142h120" stroke="#5c4012" stroke-width="4" stroke-linecap="round"></path>
  {holes.map((x) => (
    <circle cx={x} cy="134" r="1.8" fill="#3b2a0c"></circle>
  ))}
  <path d="M58 46c0-14 28-26 62-26s62 12 62 26z" fill="url(#brass)"></path>
  <circle cx="120" cy="16" r="7" fill="url(#brass)"></circle>
  <path d="M74 70h92M74 100h92" stroke="#fff3cf" stroke-opacity="0.4" stroke-width="2"></path>
</svg>

<style>
  .brass-filter {
    width: min(100%, 260px);
    justify-self: center;
  }

  .brass-filter__label {
    fill: #2c1f08;
    font: 600 13px var(--font-sans);
    font-stretch: 110%;
  }
</style>
