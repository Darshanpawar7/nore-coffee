---
import CartPage from '../../components/islands/CartPage';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Your cart"
  description="Your Nore cart: what is in it, the shipping, coupons and delivery dates."
>
  <div class="wrap narrow">
    <h1 class="page-title">Your cart</h1>
    <CartPage client:load />
    <noscript>
      <p class="serif">
        Your cart is kept in this browser and needs JavaScript to open. Everything else on the site
        works without it.
      </p>
    </noscript>
  </div>
</BaseLayout>
